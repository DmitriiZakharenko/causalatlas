# Copy this file to .env and fill in real values. Never commit .env.
# Backend loads these via python-dotenv; never hardcode secrets in source.
#
# NOTE: there is no ANTHROPIC_API_KEY here on purpose. Every agent's LLM call
# (including the Phase 4 independent judge) runs by shelling out to the `claude`
# CLI, authenticated via the developer's existing Claude subscription (OAuth
# login, `claude login`) -- zero pay-per-token API cost. See docs/architecture.md.
# All three data-source keys below are free-only: no paid tier exists for any
# of them (see skills/pubmed-literature-search/SKILL.md for the exact rules).

# PubMed E-utilities (https://www.ncbi.nlm.nih.gov/books/NBK25497/)
# Free registration at https://www.ncbi.nlm.nih.gov/account/ raises the rate
# limit from 3 req/sec (keyless) to 10 req/sec. Leave blank to run keyless.
PUBMED_API_KEY=
PUBMED_EMAIL=

# Semantic Scholar Graph API (https://www.semanticscholar.org/product/api)
# Free; keyless works at low volume. Optional key raises the rate limit, still $0.
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex API (https://docs.openalex.org/) -- fully free, no key ever required.
# Put a real contact email to join the free "polite pool" (higher rate limit).
OPENALEX_MAILTO=

# Backend
DATABASE_URL=sqlite+aiosqlite:///./data/loopfinder.db
BACKEND_PORT=8000

# Frontend
VITE_API_BASE_URL=http://localhost:8000
