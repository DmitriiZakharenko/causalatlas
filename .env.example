# Copy this file to .env and fill in real values. Never commit .env.
# Backend loads these via python-dotenv; never hardcode secrets in source.

# PubMed E-utilities (https://www.ncbi.nlm.nih.gov/books/NBK25497/)
PUBMED_API_KEY=
PUBMED_EMAIL=

# Anthropic (used by every agent call + the Phase 4 independent judge)
ANTHROPIC_API_KEY=

# Backend
DATABASE_URL=sqlite+aiosqlite:///./data/loopfinder.db
BACKEND_PORT=8000

# Frontend
VITE_API_BASE_URL=http://localhost:8000
